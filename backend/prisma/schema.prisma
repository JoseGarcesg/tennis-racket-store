generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Racket {
  id          Int      @id @default(autoincrement())
  name        String
  brand       String
  description String
  price       Float
  image       String
  stock       Int
  createdAt   DateTime @default(now())
}

model Order {
  id            Int      @id @default(autoincrement())
  customerName  String
  email         String
  paymentMethod String
  total         Float
  createdAt     DateTime @default(now())
}